'Full-screen program editor (see editor.bm).

'key codes, as returned by _KEYHIT
CONST EK_UP = 18432, EK_DOWN = 20480, EK_LEFT = 19200, EK_RIGHT = 19712
CONST EK_HOME = 18176, EK_END = 20224, EK_PGUP = 18688, EK_PGDN = 20736
CONST EK_INS = 20992, EK_DEL = 21248, EK_F1 = 15104, EK_F3 = 15616, EK_F5 = 16128
CONST EK_BKSP = 8, EK_TAB = 9, EK_ENTER = 13, EK_ESC = 27

'palette slots on the editor's screen (set in edOpenScreen)
CONST EC_BG = 0, EC_CURLINE = 1, EC_SEL = 2, EC_ERRLINE = 3, EC_BAR = 4, EC_MATCH = 5
CONST EC_BARTEXT = 6, EC_TEXT = 7, EC_GUTTER = 8, EC_KEYWORD = 9, EC_NUMBER = 10
CONST EC_STRING = 11, EC_COMMENT = 12, EC_META = 13, EC_LABEL = 14, EC_BRIGHT = 15

CONST ED_UNDO_MAX = 300, ED_TAB = 4

REDIM SHARED edL(1 TO 1) AS STRING 'the text being edited
DIM SHARED edN AS LONG 'number of lines
DIM SHARED edCY AS LONG, edCX AS LONG, edWantX AS LONG 'cursor (line, column)
DIM SHARED edTop AS LONG, edLeft AS LONG 'first line shown, columns scrolled
DIM SHARED edSelOn AS _BYTE, edSY AS LONG, edSX AS LONG 'selection anchor
DIM SHARED edIns AS _BYTE, edQuit AS INTEGER, edMsg$, edErrLine AS LONG
DIM SHARED edRows AS INTEGER, edCols AS INTEGER, edGW AS INTEGER
DIM SHARED edFind$, edRepl$, edFoundY AS LONG, edFoundX AS LONG
REDIM SHARED edUndo(0) AS STRING, edRedo(0) AS STRING
DIM SHARED edUndoN AS LONG, edRedoN AS LONG, edLastKind AS INTEGER, edSavedAt AS LONG
DIM SHARED edEdited AS _BYTE
DIM SHARED edShift AS _BYTE, edCtrl AS _BYTE, edAlt AS _BYTE
DIM SHARED edKeyQ$, edScriptEnd AS _BYTE, edClip$, edClipLine$
DIM SHARED edPromptCancel AS _BYTE, edMouseDown AS _BYTE, edMouseY AS INTEGER, edMouseX AS INTEGER
DIM SHARED edClickT AS DOUBLE, edClickY AS LONG, edClickX AS LONG
DIM SHARED edLastFile$, edLastCY AS LONG, edLastCX AS LONG, edLastTop AS LONG
DIM SHARED edLastText$, edLastValid AS _BYTE
DIM SHARED edKeywords$, lastErrorMsg$
DIM SHARED edPal(0 TO 15) AS _UNSIGNED LONG, edImg AS LONG, edPointer AS INTEGER
DIM SHARED edBlinkT AS DOUBLE, edBlinkOn AS _BYTE, edTypedLine AS LONG

edRows = 32: edCols = 100: edIns = -1
edSetPalette
edKeywords$ = " ABS ACCESS AND APPEND AS ASC ATN BEEP BINARY BLOAD BSAVE BYVAL CALL CASE CDBL CHAIN CHDIR CHR$ CINT CIRCLE CLEAR CLNG CLOSE CLS COLOR COMMAND$ COMMON CONST COS CSNG CSRLIN CVD CVI CVL CVS DATA DATE$ DECLARE DEF DEFDBL DEFINT DEFLNG DEFSNG DEFSTR DIM DO DOUBLE DRAW ELSE ELSEIF END ENVIRON$ EOF EQV ERASE ERL ERR ERROR EXIT EXP FIELD FILES FIX FOR FREEFILE FUNCTION GET GOSUB GOTO HEX$ IF IMP INKEY$ INPUT INPUT$ INSTR INT INTEGER IS KEY KILL LBOUND LCASE$ LEFT$ LEN LET LINE LOC LOCATE LOF LOG LONG LOOP LSET LTRIM$ MID$ MKD$ MKDIR MKI$ MKL$ MKS$ MOD NAME NEXT NOT OCT$ OFF ON OPEN OPTION OR OUT OUTPUT PAINT PALETTE PCOPY PEEK PLAY POINT POKE POS PRESET PRINT PSET PUT RANDOM RANDOMIZE READ REDIM REM RESET RESTORE RESUME RETURN RIGHT$ RMDIR RND RSET RTRIM$ RUN SCREEN SEEK SELECT SGN SHARED SHELL SIN SINGLE SLEEP SOUND SPACE$ SPC SQR STATIC STEP STOP STR$ STRING STRING$ SUB SWAP SYSTEM TAB TAN THEN TIME$ TIMER TO TYPE UBOUND UCASE$ UNTIL USING VAL VIEW WAIT WEND WHILE WIDTH WINDOW WRITE XOR "
edKeywords$ = edKeywords$ + "_ALPHA _ALPHA32 _ATAN2 _AUTODISPLAY _BACKGROUNDCOLOR _BIN$ _BIT _BLEND _BLINK _BLUE _BLUE32 _BYTE _CEIL _CLEARCOLOR _CLIPBOARD$ _CONSOLE _CONTINUE _COPYIMAGE _CWD$ _D2R _DEFAULTCOLOR _DEFINE _DELAY _DESKTOPHEIGHT _DESKTOPWIDTH _DEST _DIREXISTS _DISPLAY _DONTBLEND _ECHO _EXIT _EXPLICIT _FILEEXISTS _FLOAT _FONT _FONTHEIGHT _FONTWIDTH _FREEIMAGE _FULLSCREEN _GREEN _GREEN32 _HEIGHT _HYPOT _INSTRREV _INTEGER64 _KEYCLEAR _KEYDOWN _KEYHIT _LIMIT _LOADFONT _LOADIMAGE _MAX _MEM _MIN _MOUSEBUTTON _MOUSEINPUT _MOUSEWHEEL _MOUSEX _MOUSEY _NEWIMAGE _OFFSET _OS$ _PALETTECOLOR _PI _PIXELSIZE _PRESERVE _PRINTSTRING _PRINTWIDTH _PUTIMAGE _R2D _READBIT _RED _RED32 _RESETBIT _RESIZE _RESIZEHEIGHT _RESIZEWIDTH _RGB _RGB32 _RGBA _RGBA32 _ROUND _SCALEDHEIGHT _SCALEDWIDTH _SCREENHIDE _SCREENMOVE _SCREENSHOW _SCREENX _SCREENY _SETBIT _SHL _SHR _SNDCLOSE _SNDLOOP _SNDOPEN _SNDPLAY _SNDSTOP _SOURCE _STARTDIR$ _STRCMP _STRICMP _TITLE _TOGGLEBIT _TRIM$ _UNSIGNED _WIDTH "
