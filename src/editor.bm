'Full-screen program editor, opened by EDIT and NEW.
'
'It edits program() directly. In -script mode it reads its keys from the
'script instead of the keyboard: plain text is typed as is and {name} sends
'a special key, e.g. {enter} {esc} {up} {shift+end} {ctrl+z} {f3}.
'Nothing is drawn then; status messages are printed instead.

FUNCTION edRun%
    'returns ED_CLOSE (Esc), ED_RUN (F5) or ED_STEP (F7/F8: run paused)
    DIM i AS LONG

    edN = UBOUND(program)
    IF edN < 1 THEN edN = 1
    REDIM edL(1 TO edN) AS STRING
    FOR i = 1 TO UBOUND(program): edL(i) = program(i): NEXT
    IF UBOUND(edMark) <> edN THEN REDIM _PRESERVE edMark(1 TO edN) AS _BYTE

    edCY = 1: edCX = 1: edTop = 1: edLeft = 0
    IF loadedFile$ = edLastFile$ AND edLastCY <= edN THEN
        edCY = edLastCY: edCX = edLastCX: edTop = edLastTop
    END IF
    edSelOn = 0: edQuit = 0: edMsg$ = "": edErrLine = 0
    edLastKind = -1: edEdited = 0: edMouseDown = 0: edScriptEnd = 0: edTypedLine = 0
    'undo history survives closing the editor, unless the program was
    'changed (or replaced) at the prompt in the meantime
    IF MID$(edSnap$, 9) <> edLastText$ OR edLastValid = 0 THEN
        edUndoN = 0: edRedoN = 0: edSavedAt = 0
    END IF
    edCalcGutter
    IF lineThatErrored >= 1 AND lineThatErrored <= edN THEN
        edCY = lineThatErrored: edCX = edFirstNonSpace&(edCY): edErrLine = edCY
        edSetMsg lastErrorMsg$ + " on line" + STR$(edCY)
        edTop = edCY - edTR \ 2
    END IF
    edClampX
    edWantX = edCX
    edEnsureVisible

    IF NOT headless THEN edScreenOpen _COPYIMAGE(0)
    edLoop
    IF NOT headless THEN edScreenClose: _AUTODISPLAY
    edKeyQ$ = ""
    IF edTypedLine THEN edFixIndent edTypedLine: edTypedLine = 0

    'hand the text back
    REDIM program(edN) AS STRING
    FOR i = 1 TO edN: program(i) = edL(i): NEXT
    IF edEdited THEN lineThatErrored = 0
    edLastFile$ = loadedFile$: edLastCY = edCY: edLastCX = edCX: edLastTop = edTop
    edLastText$ = MID$(edSnap$, 9): edLastValid = -1
    edRun% = edQuit
END FUNCTION

SUB edScreenOpen (behind AS LONG)
    'switches to the editor's screen; behind is the screen F4 shows
    edPrevTitle$ = curTitle$
    edPrevScreen = behind
    edImg = _NEWIMAGE(edCols * 8, edRows * 16, 32)
    SCREEN edImg
    KEY OFF
    setSoftKeys false
    _KEYCLEAR
    _RESIZE ON
    IF _RESIZE THEN edPointer = 0 'drop a stale event left from the other screen
END SUB

SUB edScreenClose
    _RESIZE OFF
    _MOUSESHOW "DEFAULT"
    SCREEN edPrevScreen
    _FREEIMAGE edImg
    setTitle edPrevTitle$
    setSoftKeys true
    IF screenKeyStatus THEN KEY ON
    _KEYCLEAR
END SUB

SUB edLoop
    'the editor's main loop, until edQuit is set
    DIM k AS LONG, redraw AS _BYTE
    IF headless THEN
        DO
            k = edGetKey&
            IF k THEN edHandleKey k
            IF edScriptEnd THEN
                IF dbgPaused THEN edQuit = ED_STOP ELSE edQuit = ED_CLOSE
            END IF
        LOOP UNTIL edQuit
        EXIT SUB
    END IF
    edPointer = 0
    edBlinkT = TIMER
    edEnsureVisible
    redraw = -1
    DO
        DO
            k = edGetKey&
            IF k = 0 THEN EXIT DO
            edHandleKey k
            redraw = -1: edBlinkT = TIMER
            IF edQuit THEN EXIT DO
        LOOP
        IF edQuit = 0 THEN
            IF edMouse%% THEN redraw = -1: edBlinkT = TIMER: IF edMouseDown <> 1 THEN edLeaveLineCheck
            IF edResized%% THEN redraw = -1
            IF edBlinkPhase%% <> edBlinkOn THEN redraw = -1
            IF redraw THEN edDraw: _DISPLAY: redraw = 0
            _LIMIT 60
        END IF
    LOOP UNTIL edQuit
END SUB

'---------------------------------------------------------------- keys
FUNCTION edGetKey&
    'next key, or 0 when none is waiting; sets edShift/edCtrl/edAlt
    DIM k AS LONG
    IF scriptMode THEN edGetKey& = edScriptKey&: EXIT FUNCTION
    DO
        k = _KEYHIT
        IF k = 0 THEN EXIT FUNCTION
        'Alt pressed and released on its own opens the menus
        IF k = 100307 OR k = 100308 THEN edAltAlone = -1
        IF (k = -100307 OR k = -100308) AND edAltAlone THEN
            edAltAlone = 0: edShift = 0: edCtrl = 0: edAlt = 0
            edGetKey& = EK_MENU
            EXIT FUNCTION
        END IF
        IF k > 0 AND k < 100000 THEN edAltAlone = 0
    LOOP UNTIL k > 0 AND k < 100000 'skip key releases and lone modifiers
    edShift = _KEYDOWN(100303) OR _KEYDOWN(100304)
    edCtrl = _KEYDOWN(100305) OR _KEYDOWN(100306)
    edCtrl = edCtrl OR _KEYDOWN(100309) OR _KEYDOWN(100310) OR _KEYDOWN(100311) OR _KEYDOWN(100312) 'Cmd on macOS
    edAlt = _KEYDOWN(100307) OR _KEYDOWN(100308)
    'some platforms send the old DOS codes for modified keys
    SELECT CASE k
        CASE 29440: k = EK_LEFT: edCtrl = -1
        CASE 29696: k = EK_RIGHT: edCtrl = -1
        CASE 30464: k = EK_HOME: edCtrl = -1
        CASE 29952: k = EK_END: edCtrl = -1
        CASE 3840: k = EK_TAB: edShift = -1
        CASE 22016: k = EK_F3: edShift = -1
        CASE 1 TO 26
            IF edCtrl AND k <> 8 AND k <> 9 AND k <> 13 THEN k = k + 96
        CASE 65 TO 90
            IF edCtrl THEN k = k + 32
    END SELECT
    edGetKey& = k
END FUNCTION

FUNCTION edScriptKey&
    DIM j AS LONG, nm$, k AS LONG
    edShift = 0: edCtrl = 0: edAlt = 0
    DO WHILE edKeyQ$ = ""
        scriptPos = scriptPos + 1
        IF scriptPos > UBOUND(scriptLines) THEN edScriptEnd = -1: edScriptKey& = EK_ESC: EXIT FUNCTION
        edKeyQ$ = scriptLines(scriptPos)
    LOOP
    j = INSTR(edKeyQ$, "}")
    IF LEFT$(edKeyQ$, 1) = "{" AND j > 2 THEN
        nm$ = LCASE$(MID$(edKeyQ$, 2, j - 2))
        edKeyQ$ = MID$(edKeyQ$, j + 1)
        DO
            IF LEFT$(nm$, 5) = "ctrl+" THEN
                edCtrl = -1: nm$ = MID$(nm$, 6)
            ELSEIF LEFT$(nm$, 6) = "shift+" THEN
                edShift = -1: nm$ = MID$(nm$, 7)
            ELSEIF LEFT$(nm$, 4) = "alt+" THEN
                edAlt = -1: nm$ = MID$(nm$, 5)
            ELSE
                EXIT DO
            END IF
        LOOP
        SELECT CASE nm$
            CASE "up": k = EK_UP
            CASE "down": k = EK_DOWN
            CASE "left": k = EK_LEFT
            CASE "right": k = EK_RIGHT
            CASE "home": k = EK_HOME
            CASE "end": k = EK_END
            CASE "pgup": k = EK_PGUP
            CASE "pgdn": k = EK_PGDN
            CASE "ins": k = EK_INS
            CASE "del": k = EK_DEL
            CASE "bksp": k = EK_BKSP
            CASE "tab": k = EK_TAB
            CASE "enter": k = EK_ENTER
            CASE "esc": k = EK_ESC
            CASE "space": k = 32
            CASE "lbrace": k = 123
            CASE "f10": k = EK_F10
            CASE "f11": k = 34048
            CASE "f12": k = EK_F12
            CASE "menu": k = EK_MENU
            CASE "f1" TO "f9": IF LEN(nm$) = 2 THEN k = EK_F1 + (VAL(MID$(nm$, 2)) - 1) * 256
            CASE ELSE: IF LEN(nm$) = 1 THEN k = ASC(nm$)
        END SELECT
        IF k = 0 THEN PRINT "editor: unknown key {"; nm$; "}"
        edScriptKey& = k
    ELSE
        edScriptKey& = ASC(edKeyQ$)
        edKeyQ$ = MID$(edKeyQ$, 2)
    END IF
END FUNCTION

SUB edHandleKey (k AS LONG)
    DIM hadSel AS _BYTE, sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG, n AS LONG, t$

    edMsg$ = ""
    IF edDebugKey%%(k) THEN edEnsureVisible: EXIT SUB
    IF edAlt AND NOT edCtrl AND ((k >= 65 AND k <= 90) OR (k >= 97 AND k <= 122)) THEN
        IF edMenuForKey%(k) THEN edMenu edMenuForKey%(k) 'Alt+letter opens a menu
        EXIT SUB
    END IF
    IF edCtrl AND NOT edAlt THEN
        SELECT CASE k
            CASE 97: edSelectAll 'a
            CASE 110: edNewFile 'n
            CASE 111: edOpenFile 'o
            CASE 99: edCopy 0 'c
            CASE 120: edCopy -1 'x
            CASE 118: edPaste 'v
            CASE 122: IF edShift THEN edRedoStep ELSE edUndoStep 'z
            CASE 121: edRedoStep 'y
            CASE 102: edFindPrompt 'f
            CASE 104, 114: edReplacePrompt 'h, r
            CASE 103: edGotoPrompt 'g
            CASE 115: edSave edShift 's
            CASE 100: edDuplicate 'd
            CASE 107: edDeleteLines 'k
            CASE 47: edToggleComment '/
            CASE EK_HOME, EK_END, EK_LEFT, EK_RIGHT, EK_UP, EK_DOWN: edNavigate k
        END SELECT
        edEnsureVisible
        EXIT SUB
    END IF

    SELECT CASE k
        CASE EK_LEFT, EK_RIGHT, EK_UP, EK_DOWN, EK_HOME, EK_END, EK_PGUP, EK_PGDN
            IF edAlt AND (k = EK_UP OR k = EK_DOWN) THEN edMoveLines k ELSE edNavigate k
        CASE EK_ENTER
            edBeginEdit 0
            edDeleteSel
            edNewLine
        CASE EK_BKSP
            IF edHasSel%% THEN
                edBeginEdit 0: edDeleteSel
            ELSEIF edCX > 1 THEN
                edBeginEdit 2
                n = 1
                IF LEN(_TRIM$(LEFT$(edL(edCY), edCX - 1))) = 0 THEN n = (edCX - 2) MOD ED_TAB + 1 'unindent
                edL(edCY) = LEFT$(edL(edCY), edCX - 1 - n) + MID$(edL(edCY), edCX)
                edCX = edCX - n
            ELSEIF edCY > 1 THEN
                edBeginEdit 0
                edCX = LEN(edL(edCY - 1)) + 1
                edL(edCY - 1) = edL(edCY - 1) + edL(edCY)
                edRemoveLines edCY, 1
                edCY = edCY - 1
            END IF
            edWantX = edCX
        CASE EK_DEL
            IF edHasSel%% THEN
                edBeginEdit 0: edDeleteSel
            ELSEIF edCX <= LEN(edL(edCY)) THEN
                edBeginEdit 3
                edL(edCY) = LEFT$(edL(edCY), edCX - 1) + MID$(edL(edCY), edCX + 1)
            ELSEIF edCY < edN THEN
                edBeginEdit 0
                edL(edCY) = edL(edCY) + edL(edCY + 1)
                edRemoveLines edCY + 1, 1
            END IF
        CASE EK_TAB
            hadSel = edGetSel%(sy, sx, ey, ex)
            IF edShift THEN
                edIndent -1
            ELSEIF hadSel AND ey > sy THEN
                edIndent 1
            ELSE
                IF hadSel THEN edBeginEdit 0: edDeleteSel ELSE edBeginEdit 1
                edInsertText SPACE$(ED_TAB - (edCX - 1) MOD ED_TAB)
            END IF
        CASE EK_INS: edIns = NOT edIns
        CASE EK_F1: edHelp
        CASE EK_F3: IF edFind$ = "" THEN edFindPrompt ELSE edFindNext edShift
        CASE EK_F4: edShowOutput
        CASE EK_MENU: edMenu 1
        CASE EK_F5: edQuit = ED_RUN
        CASE EK_ESC: edQuit = ED_CLOSE
        CASE 32 TO 126, 128 TO 255
            IF edHasSel%% THEN
                edBeginEdit 0: edDeleteSel: edLastKind = 1
            ELSE
                edBeginEdit 1
            END IF
            edTypedLine = edCY
            IF edIns = 0 AND edCX <= LEN(edL(edCY)) THEN
                MID$(edL(edCY), edCX, 1) = CHR$(k)
                edCX = edCX + 1
            ELSE
                edInsertText CHR$(k)
            END IF
            edWantX = edCX
    END SELECT
    edLeaveLineCheck
    edEnsureVisible
END SUB

FUNCTION edDebugKey%% (k AS LONG)
    'debugger keys, and what's allowed while the program is paused.
    'Returns true when the key was dealt with.
    DIM handled AS _BYTE
    handled = -1
    SELECT CASE k
        CASE EK_F7, EK_F8
            IF dbgPaused THEN
                IF k = EK_F7 THEN edQuit = ED_INTO ELSE edQuit = ED_OVER
            ELSE
                edQuit = ED_STEP 'start running, paused at the first line
            END IF
        CASE EK_F6
            IF dbgPaused = 0 THEN
                edSetMsg "F6 steps out of a SUB or FUNCTION while debugging"
            ELSEIF callDepth = 0 THEN
                edSetMsg "Not inside a SUB or FUNCTION"
            ELSE
                edQuit = ED_OUT
            END IF
        CASE EK_F5: IF dbgPaused THEN edQuit = ED_CONTINUE ELSE handled = 0
        CASE EK_ESC: IF dbgPaused THEN edQuit = ED_STOP ELSE handled = 0
        CASE EK_F9
            IF edCtrl THEN dbgToggleMark edCY, MARK_SKIP ELSE dbgToggleMark edCY, MARK_BREAK
        CASE EK_F10
            IF edShift THEN
                edContextMenu edCX - edLeft + edGW, edCY - edTop + 3 'the right-click menu, at the cursor
            ELSEIF edCtrl THEN
                edCommand "setnext"
            ELSE
                dbgClearBreakpoints
            END IF
        CASE EK_F12: dbgCallStack
        CASE ELSE
            handled = 0
            IF edCtrl AND (k = 119 OR k = 23) THEN dbgVarList: handled = -1 'Ctrl+W
    END SELECT
    IF handled OR dbgPaused = 0 THEN edDebugKey%% = handled: EXIT FUNCTION

    'paused: the text can't change
    SELECT CASE k
        CASE EK_LEFT, EK_RIGHT, EK_UP, EK_DOWN, EK_HOME, EK_END, EK_PGUP, EK_PGDN
            IF edAlt THEN handled = -1
        CASE EK_F1, EK_F3, EK_F4, EK_MENU, EK_INS
        CASE ELSE
            IF edCtrl THEN
                SELECT CASE k
                    CASE 97, 99, 102, 103, 115 'select all, copy, find, go to, save
                    CASE ELSE: handled = -1
                END SELECT
            ELSEIF edAlt AND ((k >= 65 AND k <= 90) OR (k >= 97 AND k <= 122)) THEN
                'Alt+letter opens a menu
            ELSE
                handled = -1
            END IF
    END SELECT
    IF handled THEN edSetMsg "The program is paused: F5 continues, Esc stops it"
    edDebugKey%% = handled
END FUNCTION

SUB edSelectAll
    edSelOn = -1: edSY = 1: edSX = 1
    edCY = edN: edCX = LEN(edL(edN)) + 1: edLastKind = -1
END SUB

SUB edNewLine
    'Enter with auto-indent: a closing line (NEXT, LOOP, END IF, ELSE,
    'CASE...) is lined up with its block first, and the new line is
    'indented one more level after a line that opens a block
    DIM n AS LONG, kind AS INTEGER
    edFixIndent edCY
    edTypedLine = 0
    n = edFirstNonSpace&(edCY) - 1
    IF n >= edCX - 1 THEN
        n = edCX - 1 'Enter inside the indentation
    ELSE
        kind = edLineKind%(LEFT$(edL(edCY), edCX - 1))
        IF kind = 1 OR kind = 3 THEN n = n + ED_TAB
    END IF
    edInsertText CHR$(10) + SPACE$(n)
END SUB

SUB edFixIndent (y AS LONG)
    'lines up a closing/middle line (NEXT, END IF, ELSE, CASE...) with its block
    DIM n AS LONG, target AS LONG
    IF y < 1 OR y > edN THEN EXIT SUB
    IF edLineKind%(edL(y)) < 2 THEN EXIT SUB
    target = edBlockIndent&(y)
    n = edFirstNonSpace&(y) - 1
    IF target < 0 OR target = n THEN EXIT SUB
    edL(y) = SPACE$(target) + LTRIM$(edL(y))
    IF y = edCY THEN
        IF edCX > n THEN edCX = edCX + target - n ELSE IF edCX > target + 1 THEN edCX = target + 1
        IF edCX < 1 THEN edCX = 1
        edWantX = edCX
    END IF
END SUB

SUB edLeaveLineCheck
    'typing on a line and then moving off it re-aligns it
    IF edTypedLine > 0 AND edTypedLine <> edCY THEN edFixIndent edTypedLine: edTypedLine = 0
END SUB

FUNCTION edLineKind% (text$)
    '1 opens a block, 2 closes one, 3 is a middle part (ELSE, ELSEIF, CASE)
    DIM t$, i AS LONG, q AS _BYTE, w$, net AS LONG, first AS _BYTE, kind AS INTEGER, part$
    'drop a comment
    t$ = text$
    FOR i = 1 TO LEN(t$)
        IF ASC(t$, i) = 34 THEN q = NOT q
        IF ASC(t$, i) = 39 AND q = 0 THEN t$ = LEFT$(t$, i - 1): EXIT FOR
    NEXT
    t$ = UCASE$(_TRIM$(t$))
    IF t$ = "" THEN EXIT FUNCTION
    'look at each statement on the line
    first = -1: q = 0
    t$ = t$ + ":"
    FOR i = 1 TO LEN(t$)
        IF ASC(t$, i) = 34 THEN q = NOT q
        IF ASC(t$, i) = 58 AND q = 0 THEN
            w$ = edFirstWord$(part$)
            IF w$ = "REM" THEN EXIT FOR
            SELECT CASE w$
                CASE "FOR", "DO", "WHILE", "SUB", "FUNCTION", "TYPE", "SELECT"
                    net = net + 1: IF first THEN kind = 1
                CASE "IF"
                    IF RIGHT$(_TRIM$(part$), 5) = " THEN" THEN net = net + 1: IF first THEN kind = 1
                CASE "NEXT", "LOOP", "WEND"
                    net = net - 1: IF first THEN kind = 2
                CASE "END"
                    SELECT CASE edFirstWord$(MID$(_TRIM$(part$), 4))
                        CASE "IF", "SUB", "FUNCTION", "SELECT", "TYPE"
                            net = net - 1: IF first THEN kind = 2
                    END SELECT
                CASE "ELSE", "ELSEIF", "CASE"
                    IF first THEN kind = 3
            END SELECT
            first = 0: part$ = ""
        ELSE
            part$ = part$ + CHR$(ASC(t$, i))
        END IF
    NEXT
    IF kind = 1 AND net <= 0 THEN kind = 0 'opened and closed on the same line
    edLineKind% = kind
END FUNCTION

FUNCTION edFirstWord$ (t$)
    DIM u$, i AS LONG
    u$ = LTRIM$(t$)
    FOR i = 1 TO LEN(u$)
        IF INSTR(" (", MID$(u$, i, 1)) THEN EXIT FOR
    NEXT
    edFirstWord$ = LEFT$(u$, i - 1)
END FUNCTION

FUNCTION edBlockIndent& (y AS LONG)
    'the indent a closing/middle line should have, or -1 if no block is open
    DIM i AS LONG, depth AS LONG, k AS INTEGER
    FOR i = y - 1 TO 1 STEP -1
        k = edLineKind%(edL(i))
        IF k = 2 THEN
            depth = depth + 1
        ELSEIF k = 1 THEN
            IF depth = 0 THEN
                edBlockIndent& = edFirstNonSpace&(i) - 1
                'CASE lines sit one level inside SELECT CASE
                IF edFirstWord$(UCASE$(edL(y))) = "CASE" AND edFirstWord$(UCASE$(edL(i))) = "SELECT" THEN edBlockIndent& = edFirstNonSpace&(i) - 1 + ED_TAB
                EXIT FUNCTION
            END IF
            depth = depth - 1
        END IF
    NEXT
    edBlockIndent& = -1
END FUNCTION

SUB edNavigate (k AS LONG)
    DIM sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG, rows AS LONG

    'Left/Right without Shift collapse a selection to its edge
    IF (k = EK_LEFT OR k = EK_RIGHT) AND edShift = 0 AND edCtrl = 0 THEN
        IF edGetSel%(sy, sx, ey, ex) THEN
            IF k = EK_LEFT THEN edCY = sy: edCX = sx ELSE edCY = ey: edCX = ex
            edSelOn = 0: edWantX = edCX: edLastKind = -1
            EXIT SUB
        END IF
    END IF

    IF edShift THEN
        IF edSelOn = 0 THEN edSelOn = -1: edSY = edCY: edSX = edCX
    ELSE
        edSelOn = 0
    END IF
    edLastKind = -1
    rows = edTR

    SELECT CASE k
        CASE EK_LEFT
            IF edCtrl THEN
                edWordLeft
            ELSEIF edCX > 1 THEN
                edCX = edCX - 1
            ELSEIF edCY > 1 THEN
                edCY = edCY - 1: edCX = LEN(edL(edCY)) + 1
            END IF
            edWantX = edCX
        CASE EK_RIGHT
            IF edCtrl THEN
                edWordRight
            ELSEIF edCX <= LEN(edL(edCY)) THEN
                edCX = edCX + 1
            ELSEIF edCY < edN THEN
                edCY = edCY + 1: edCX = 1
            END IF
            edWantX = edCX
        CASE EK_UP
            IF edCtrl THEN
                IF edTop > 1 THEN edTop = edTop - 1
                IF edCY > edTop + rows - 1 THEN edCY = edTop + rows - 1
            ELSEIF edCY > 1 THEN
                edCY = edCY - 1
            ELSE
                edWantX = 1
            END IF
            edCX = edWantX
        CASE EK_DOWN
            IF edCtrl THEN
                IF edTop < edN THEN edTop = edTop + 1
                IF edCY < edTop THEN edCY = edTop
            ELSEIF edCY < edN THEN
                edCY = edCY + 1
            ELSE
                edWantX = LEN(edL(edCY)) + 1
            END IF
            edCX = edWantX
        CASE EK_PGUP
            edCY = edCY - (rows - 1): edTop = edTop - (rows - 1)
            IF edCY < 1 THEN edCY = 1
            IF edTop < 1 THEN edTop = 1
            edCX = edWantX
        CASE EK_PGDN
            edCY = edCY + (rows - 1): edTop = edTop + (rows - 1)
            IF edCY > edN THEN edCY = edN
            IF edTop > edN THEN edTop = edN
            edCX = edWantX
        CASE EK_HOME
            IF edCtrl THEN
                edCY = 1: edCX = 1
            ELSEIF edCX <> edFirstNonSpace&(edCY) THEN
                edCX = edFirstNonSpace&(edCY)
            ELSE
                edCX = 1
            END IF
            edWantX = edCX
        CASE EK_END
            IF edCtrl THEN edCY = edN
            edCX = LEN(edL(edCY)) + 1
            edWantX = edCX
    END SELECT
    edClampX
END SUB

FUNCTION edIsWordChar%% (c$)
    IF c$ = "" THEN EXIT FUNCTION
    SELECT CASE ASC(c$)
        CASE 48 TO 57, 65 TO 90, 97 TO 122, 95, 36: edIsWordChar%% = -1
    END SELECT
END FUNCTION

SUB edWordLeft
    IF edCX = 1 THEN
        IF edCY > 1 THEN edCY = edCY - 1: edCX = LEN(edL(edCY)) + 1
        EXIT SUB
    END IF
    DO WHILE edCX > 1 AND edIsWordChar%%(MID$(edL(edCY), edCX - 1, 1)) = 0: edCX = edCX - 1: LOOP
    DO WHILE edCX > 1 AND edIsWordChar%%(MID$(edL(edCY), edCX - 1, 1)): edCX = edCX - 1: LOOP
END SUB

SUB edWordRight
    DIM n AS LONG
    n = LEN(edL(edCY))
    IF edCX > n THEN
        IF edCY < edN THEN edCY = edCY + 1: edCX = 1
        EXIT SUB
    END IF
    DO WHILE edCX <= n AND edIsWordChar%%(MID$(edL(edCY), edCX, 1)): edCX = edCX + 1: LOOP
    DO WHILE edCX <= n AND edIsWordChar%%(MID$(edL(edCY), edCX, 1)) = 0: edCX = edCX + 1: LOOP
END SUB

'---------------------------------------------------------------- text primitives
FUNCTION edFirstNonSpace& (y AS LONG)
    DIM i AS LONG
    FOR i = 1 TO LEN(edL(y))
        IF ASC(edL(y), i) <> 32 THEN edFirstNonSpace& = i: EXIT FUNCTION
    NEXT
    edFirstNonSpace& = LEN(edL(y)) + 1
END FUNCTION

SUB edClampX
    IF edCY < 1 THEN edCY = 1
    IF edCY > edN THEN edCY = edN
    IF edCX < 1 THEN edCX = 1
    IF edCX > LEN(edL(edCY)) + 1 THEN edCX = LEN(edL(edCY)) + 1
END SUB

SUB edInsertLines (at AS LONG, count AS LONG)
    'adds count empty lines before line at
    DIM i AS LONG
    IF count < 1 THEN EXIT SUB
    REDIM _PRESERVE edL(1 TO edN + count) AS STRING
    IF UBOUND(edMark) < edN THEN REDIM _PRESERVE edMark(1 TO edN) AS _BYTE
    REDIM _PRESERVE edMark(1 TO edN + count) AS _BYTE
    FOR i = edN TO at STEP -1: edL(i + count) = edL(i): edMark(i + count) = edMark(i): NEXT
    FOR i = at TO at + count - 1: edL(i) = "": edMark(i) = 0: NEXT
    edN = edN + count
END SUB

SUB edRemoveLines (at AS LONG, count AS LONG)
    DIM i AS LONG
    IF count < 1 THEN EXIT SUB
    IF UBOUND(edMark) < edN THEN REDIM _PRESERVE edMark(1 TO edN) AS _BYTE
    FOR i = at + count TO edN: edL(i - count) = edL(i): edMark(i - count) = edMark(i): NEXT
    edN = edN - count
    IF edN < 1 THEN edN = 1: edL(1) = "": edMark(1) = 0
    REDIM _PRESERVE edL(1 TO edN) AS STRING
    REDIM _PRESERVE edMark(1 TO edN) AS _BYTE
END SUB

SUB edInsertText (text$)
    'inserts text$ (which may hold several lines) at the cursor
    DIM t$, i AS LONG, a AS LONG, b AS LONG, n AS LONG, after$
    t$ = text$
    DO
        i = INSTR(t$, CHR$(13))
        IF i = 0 THEN EXIT DO
        t$ = LEFT$(t$, i - 1) + MID$(t$, i + 1)
    LOOP
    DO
        i = INSTR(t$, CHR$(9))
        IF i = 0 THEN EXIT DO
        t$ = LEFT$(t$, i - 1) + SPACE$(ED_TAB) + MID$(t$, i + 1)
    LOOP
    after$ = MID$(edL(edCY), edCX)
    edL(edCY) = LEFT$(edL(edCY), edCX - 1)
    a = 1
    DO
        b = INSTR(a, t$, CHR$(10))
        IF b = 0 THEN EXIT DO
        edL(edCY + n) = edL(edCY + n) + MID$(t$, a, b - a)
        n = n + 1
        edInsertLines edCY + n, 1
        a = b + 1
    LOOP
    edL(edCY + n) = edL(edCY + n) + MID$(t$, a)
    edCY = edCY + n
    edCX = LEN(edL(edCY)) + 1
    edL(edCY) = edL(edCY) + after$
    edWantX = edCX
END SUB

FUNCTION edGetSel% (sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG)
    'the selection, start before end; 0 when nothing is selected
    IF edSelOn = 0 THEN EXIT FUNCTION
    IF edSY = edCY AND edSX = edCX THEN EXIT FUNCTION
    IF edSY < edCY OR (edSY = edCY AND edSX < edCX) THEN
        sy = edSY: sx = edSX: ey = edCY: ex = edCX
    ELSE
        sy = edCY: sx = edCX: ey = edSY: ex = edSX
    END IF
    edGetSel% = -1
END FUNCTION

FUNCTION edHasSel%%
    DIM sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG
    edHasSel%% = edGetSel%(sy, sx, ey, ex)
END FUNCTION

FUNCTION edSelText$
    DIM sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG, t$, i AS LONG
    IF edGetSel%(sy, sx, ey, ex) = 0 THEN EXIT FUNCTION
    IF sy = ey THEN edSelText$ = MID$(edL(sy), sx, ex - sx): EXIT FUNCTION
    t$ = MID$(edL(sy), sx)
    FOR i = sy + 1 TO ey - 1: t$ = t$ + CHR$(10) + edL(i): NEXT
    edSelText$ = t$ + CHR$(10) + LEFT$(edL(ey), ex - 1)
END FUNCTION

SUB edDeleteSel
    DIM sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG
    IF edGetSel%(sy, sx, ey, ex) = 0 THEN edSelOn = 0: EXIT SUB
    edL(sy) = LEFT$(edL(sy), sx - 1) + MID$(edL(ey), ex)
    edRemoveLines sy + 1, ey - sy
    edCY = sy: edCX = sx: edWantX = edCX
    edSelOn = 0
END SUB

SUB edSelLines (a AS LONG, b AS LONG)
    'the lines a selection touches (or the cursor line)
    DIM sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG
    IF edGetSel%(sy, sx, ey, ex) THEN
        a = sy: b = ey
        IF ex = 1 AND ey > sy THEN b = ey - 1
    ELSE
        a = edCY: b = edCY
    END IF
END SUB

'---------------------------------------------------------------- undo
FUNCTION edSnap$
    'the whole buffer and cursor as one string
    DIM i AS LONG, total AS LONG, p AS LONG, s$
    total = 8
    FOR i = 1 TO edN: total = total + LEN(edL(i)) + 1: NEXT
    s$ = SPACE$(total - 1)
    MID$(s$, 1) = MKL$(edCY) + MKL$(edCX)
    p = 9
    FOR i = 1 TO edN
        IF i > 1 THEN MID$(s$, p) = CHR$(10): p = p + 1
        IF LEN(edL(i)) THEN MID$(s$, p) = edL(i): p = p + LEN(edL(i))
    NEXT
    edSnap$ = s$
END FUNCTION

SUB edRestore (s$)
    DIM a AS LONG, b AS LONG, n AS LONG, i AS LONG
    n = 1
    FOR i = 9 TO LEN(s$)
        IF ASC(s$, i) = 10 THEN n = n + 1
    NEXT
    edN = n
    REDIM edL(1 TO edN) AS STRING
    REDIM _PRESERVE edMark(1 TO edN) AS _BYTE
    a = 9: n = 0
    DO
        n = n + 1
        b = INSTR(a, s$, CHR$(10))
        IF b = 0 THEN edL(n) = MID$(s$, a): EXIT DO
        edL(n) = MID$(s$, a, b - a)
        a = b + 1
    LOOP
    edCY = CVL(MID$(s$, 1, 4)): edCX = CVL(MID$(s$, 5, 4))
    edClampX
    edWantX = edCX: edSelOn = 0: edLastKind = -1
END SUB

SUB edBeginEdit (kind AS INTEGER)
    'call before changing the text. Edits of the same kind in a row
    '(typing, backspacing, deleting) are undone together; kind 0 never joins.
    DIM i AS LONG
    edEdited = -1: edErrLine = 0
    IF kind = 0 THEN edTypedLine = 0
    IF kind <> 0 AND kind = edLastKind THEN EXIT SUB
    edLastKind = kind
    IF edSavedAt > edUndoN THEN edSavedAt = -1 'the saved state can't be reached any more
    edRedoN = 0
    IF edUndoN >= ED_UNDO_MAX THEN
        FOR i = 2 TO edUndoN: edUndo(i - 1) = edUndo(i): NEXT
        edUndoN = edUndoN - 1: edSavedAt = edSavedAt - 1
    END IF
    edUndoN = edUndoN + 1
    IF edUndoN > UBOUND(edUndo) THEN REDIM _PRESERVE edUndo(edUndoN + 20) AS STRING
    edUndo(edUndoN) = edSnap$
END SUB

SUB edUndoStep
    IF edUndoN = 0 THEN edSetMsg "Nothing to undo": EXIT SUB
    edRedoN = edRedoN + 1
    IF edRedoN > UBOUND(edRedo) THEN REDIM _PRESERVE edRedo(edRedoN + 20) AS STRING
    edRedo(edRedoN) = edSnap$
    edRestore edUndo(edUndoN)
    edUndoN = edUndoN - 1
    edTypedLine = 0
    edEdited = -1
END SUB

SUB edRedoStep
    IF edRedoN = 0 THEN edSetMsg "Nothing to redo": EXIT SUB
    edUndoN = edUndoN + 1
    IF edUndoN > UBOUND(edUndo) THEN REDIM _PRESERVE edUndo(edUndoN + 20) AS STRING
    edUndo(edUndoN) = edSnap$
    edRestore edRedo(edRedoN)
    edTypedLine = 0
    edRedoN = edRedoN - 1
END SUB

SUB edForget
    'a different program was loaded: drop the undo history and line marks
    edLastValid = 0: edLastFile$ = "": edLastCY = 1: edLastCX = 1: edLastTop = 1
    REDIM edMark(1 TO 1) AS _BYTE
END SUB

FUNCTION edModified%%
    edModified%% = (edUndoN <> edSavedAt)
END FUNCTION

'---------------------------------------------------------------- line commands
SUB edIndent (dir AS INTEGER)
    'Tab / Shift+Tab on the selected lines
    DIM a AS LONG, b AS LONG, i AS LONG, n AS LONG, hadSel AS _BYTE, moved AS LONG
    edSelLines a, b
    hadSel = edHasSel%%
    edBeginEdit 0
    FOR i = a TO b
        IF dir > 0 THEN
            IF LEN(edL(i)) THEN edL(i) = SPACE$(ED_TAB) + edL(i)
            IF i = edCY THEN moved = ED_TAB
        ELSE
            n = edFirstNonSpace&(i) - 1
            IF n > 0 THEN n = (n - 1) MOD ED_TAB + 1
            edL(i) = MID$(edL(i), n + 1)
            IF i = edCY THEN moved = -n
        END IF
    NEXT
    IF hadSel THEN
        edSelOn = -1: edSY = a: edSX = 1
        IF b < edN THEN edCY = b + 1: edCX = 1 ELSE edCY = b: edCX = LEN(edL(b)) + 1
    ELSE
        edCX = edCX + moved
    END IF
    edClampX
    edWantX = edCX
END SUB

SUB edToggleComment
    DIM a AS LONG, b AS LONG, i AS LONG, ind AS LONG, allCommented AS _BYTE, f AS LONG
    edSelLines a, b
    allCommented = -1: ind = 32767
    FOR i = a TO b
        f = edFirstNonSpace&(i)
        IF f <= LEN(edL(i)) THEN
            IF f - 1 < ind THEN ind = f - 1
            IF MID$(edL(i), f, 1) <> "'" THEN allCommented = 0
        END IF
    NEXT
    IF ind = 32767 THEN EXIT SUB 'only blank lines
    edBeginEdit 0
    FOR i = a TO b
        f = edFirstNonSpace&(i)
        IF f <= LEN(edL(i)) THEN
            IF allCommented THEN
                edL(i) = LEFT$(edL(i), f - 1) + MID$(edL(i), f + 1)
            ELSE
                edL(i) = LEFT$(edL(i), ind) + "'" + MID$(edL(i), ind + 1)
            END IF
        END IF
    NEXT
    IF edSelOn THEN edClampSel
    edClampX
END SUB

SUB edClampSel
    IF edSY > edN THEN edSY = edN
    IF edSX > LEN(edL(edSY)) + 1 THEN edSX = LEN(edL(edSY)) + 1
END SUB

SUB edDuplicate
    DIM a AS LONG, b AS LONG, i AS LONG, n AS LONG
    edSelLines a, b
    n = b - a + 1
    edBeginEdit 0
    edInsertLines b + 1, n
    FOR i = 0 TO n - 1: edL(b + 1 + i) = edL(a + i): NEXT
    edCY = edCY + n
    IF edSelOn THEN edSY = edSY + n
    edClampX
END SUB

SUB edDeleteLines
    DIM a AS LONG, b AS LONG
    edSelLines a, b
    edBeginEdit 0
    edRemoveLines a, b - a + 1
    edSelOn = 0
    edCY = a
    edCX = edWantX
    edClampX
END SUB

SUB edMoveLines (k AS LONG)
    'Alt+Up / Alt+Down move the selected lines
    DIM a AS LONG, b AS LONG, i AS LONG, t$
    edSelLines a, b
    IF k = EK_UP THEN
        IF a = 1 THEN EXIT SUB
        edBeginEdit 0
        t$ = edL(a - 1)
        FOR i = a TO b: edL(i - 1) = edL(i): NEXT
        edL(b) = t$
        edCY = edCY - 1: IF edSelOn THEN edSY = edSY - 1
    ELSE
        IF b = edN THEN EXIT SUB
        edBeginEdit 0
        t$ = edL(b + 1)
        FOR i = b TO a STEP -1: edL(i + 1) = edL(i): NEXT
        edL(a) = t$
        edCY = edCY + 1: IF edSelOn THEN edSY = edSY + 1
    END IF
    edClampX
END SUB

'---------------------------------------------------------------- clipboard
SUB edSetClip (t$)
    IF headless THEN edClip$ = t$ ELSE _CLIPBOARD$ = t$
END SUB

FUNCTION edGetClip$
    IF headless THEN edGetClip$ = edClip$ ELSE edGetClip$ = _CLIPBOARD$
END FUNCTION

SUB edCopy (cut AS _BYTE)
    'with nothing selected, copies (or cuts) the whole line
    DIM t$
    IF edHasSel%% THEN
        t$ = edSelText$
        edClipLine$ = ""
        edSetClip t$
        IF cut THEN edBeginEdit 0: edDeleteSel
    ELSE
        t$ = edL(edCY) + CHR$(10)
        edClipLine$ = t$
        edSetClip t$
        IF cut THEN
            edBeginEdit 0
            edRemoveLines edCY, 1
            edCX = edWantX
            edClampX
        END IF
    END IF
END SUB

SUB edPaste
    DIM t$, x AS LONG
    t$ = edGetClip$
    IF t$ = "" THEN EXIT SUB
    edBeginEdit 0
    IF edHasSel%% THEN
        edDeleteSel
        edInsertText t$
    ELSEIF t$ = edClipLine$ THEN
        'a copied line goes above the cursor line
        x = edCX: edCX = 1
        edInsertText t$
        edCX = x: edClampX
    ELSE
        edInsertText t$
    END IF
    edSelOn = 0
END SUB

'---------------------------------------------------------------- find, replace, go to
FUNCTION edSearch%% (fromY AS LONG, fromX AS LONG, back AS _BYTE, wrap AS _BYTE)
    'finds edFind$ (any case) starting at fromY/fromX; sets edFoundY/X
    DIM n$, y AS LONG, x AS LONG, i AS LONG, tries AS LONG
    n$ = UCASE$(edFind$)
    IF n$ = "" THEN EXIT FUNCTION
    y = fromY: x = fromX
    FOR tries = 0 TO edN
        IF back THEN
            IF x >= 1 THEN i = _INSTRREV(x, UCASE$(edL(y)), n$) ELSE i = 0
        ELSE
            i = INSTR(x, UCASE$(edL(y)), n$)
        END IF
        IF i THEN edFoundY = y: edFoundX = i: edSearch%% = -1: EXIT FUNCTION
        IF back THEN
            y = y - 1
            IF y < 1 THEN
                IF wrap = 0 THEN EXIT FUNCTION
                y = edN
            END IF
            x = LEN(edL(y))
        ELSE
            y = y + 1
            IF y > edN THEN
                IF wrap = 0 THEN EXIT FUNCTION
                y = 1
            END IF
            x = 1
        END IF
    NEXT
END FUNCTION

SUB edFindNext (back AS _BYTE)
    DIM sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG, y AS LONG, x AS LONG
    IF edGetSel%(sy, sx, ey, ex) = 0 THEN sy = edCY: sx = edCX: ey = edCY: ex = edCX
    IF back THEN y = sy: x = sx - 1 ELSE y = ey: x = ex
    IF edSearch%%(y, x, back, -1) = 0 THEN edSetMsg "Not found: " + edFind$: EXIT SUB
    IF (back AND (edFoundY > y OR (edFoundY = y AND edFoundX > x))) OR (back = 0 AND (edFoundY < y OR (edFoundY = y AND edFoundX < x))) THEN
        edSetMsg "Search wrapped around"
    END IF
    edSelOn = -1: edSY = edFoundY: edSX = edFoundX
    edCY = edFoundY: edCX = edFoundX + LEN(edFind$): edWantX = edCX
    edLastKind = -1
    edEnsureVisible
END SUB

SUB edFindPrompt
    DIM t$
    t$ = edSelText$
    IF t$ = "" OR INSTR(t$, CHR$(10)) > 0 THEN t$ = edFind$
    t$ = edInputBox$("Find", "Find what:", t$)
    IF edPromptCancel OR t$ = "" THEN EXIT SUB
    edFind$ = t$
    IF edHasSel%% THEN 'search from the start of the selection
        IF edSY < edCY OR (edSY = edCY AND edSX < edCX) THEN edCY = edSY: edCX = edSX
        edSelOn = 0
    END IF
    edFindNext 0
END SUB

SUB edReplacePrompt
    DIM f$, r$, a AS INTEGER, count AS LONG, all AS _BYTE, y AS LONG, x AS LONG
    DIM lb$(1 TO 2), v$(1 TO 2)
    f$ = edSelText$
    IF f$ = "" OR INSTR(f$, CHR$(10)) > 0 THEN f$ = edFind$
    lb$(1) = "Find what:": lb$(2) = "Replace with:"
    v$(1) = f$: v$(2) = edRepl$
    IF edDialog%("Replace", 2, lb$(), v$()) = 0 THEN EXIT SUB
    f$ = v$(1): r$ = v$(2)
    IF f$ = "" THEN EXIT SUB
    edFind$ = f$: edRepl$ = r$
    'from the cursor (or the selection's start) to the end of the program
    y = edCY: x = edCX
    IF edHasSel%% THEN
        IF edSY < edCY OR (edSY = edCY AND edSX < edCX) THEN y = edSY: x = edSX
    END IF
    edBeginEdit 0
    DO
        IF edSearch%%(y, x, 0, 0) = 0 THEN EXIT DO
        edSelOn = -1: edSY = edFoundY: edSX = edFoundX
        edCY = edFoundY: edCX = edFoundX + LEN(f$)
        edEnsureVisible
        IF all THEN
            a = 65
        ELSE
            a = edConfirm%("Replace", "Replace this occurrence?", "Yes|No|All|Cancel", edCY - edTop + 2)
        END IF
        IF a = 27 OR a = 67 THEN EXIT DO
        IF a = 65 THEN all = -1: a = 89
        IF a = 89 THEN
            edL(edFoundY) = LEFT$(edL(edFoundY), edFoundX - 1) + r$ + MID$(edL(edFoundY), edFoundX + LEN(f$))
            count = count + 1
            y = edFoundY: x = edFoundX + LEN(r$)
        ELSE
            y = edFoundY: x = edFoundX + 1
        END IF
    LOOP
    edSelOn = 0
    edClampX: edWantX = edCX
    IF count = 0 THEN edUndoN = edUndoN - 1 'nothing changed
    edSetMsg _TRIM$(STR$(count)) + " replaced"
END SUB

SUB edGotoPrompt
    DIM t$, n AS LONG
    t$ = edInputBox$("Go to Line", "Line number (1-" + _TRIM$(STR$(edN)) + "):", "")
    IF edPromptCancel OR t$ = "" THEN EXIT SUB
    n = VAL(t$)
    IF n < 1 THEN n = 1
    IF n > edN THEN n = edN
    edSelOn = 0: edLastKind = -1
    edCY = n: edCX = edFirstNonSpace&(n): edWantX = edCX
    IF edCY < edTop OR edCY >= edTop + edTR THEN edTop = edCY - edTR \ 2
    edEnsureVisible
END SUB

'---------------------------------------------------------------- saving
SUB edSave (saveAs AS _BYTE)
    DIM f$, ff AS INTEGER, i AS LONG, a AS INTEGER
    f$ = loadedFile$
    IF saveAs OR f$ = "" THEN
        f$ = edInputBox$("Save As", "File name:", f$)
        IF edPromptCancel OR _TRIM$(f$) = "" THEN EXIT SUB
        f$ = _TRIM$(f$)
        IF INSTR(MID$(f$, _INSTRREV(f$, "/") + 1), ".") = 0 THEN f$ = f$ + ".bas"
        IF f$ <> loadedFile$ AND _FILEEXISTS(f$) THEN
            a = edConfirm%("Save As", f$ + " already exists. Replace it?", "Yes|No", 0)
            IF a <> 89 THEN EXIT SUB
        END IF
    END IF
    runtimeErr = 0
    ff = FREEFILE
    OPEN f$ FOR OUTPUT AS ff
    IF runtimeErr THEN edSetMsg "Can't save " + f$ + ": " + errorText$(runtimeErr): runtimeErr = 0: EXIT SUB
    FOR i = 1 TO edN: PRINT #ff, edL(i): NEXT
    CLOSE ff
    loadedFile$ = f$
    edSavedAt = edUndoN: edLastKind = -1
    edSetMsg "Saved " + f$
END SUB

'---------------------------------------------------------------- status line input
SUB edSetMsg (m$)
    edMsg$ = m$
    IF headless THEN PRINT "editor: "; m$
END SUB

'---------------------------------------------------------------- mouse
FUNCTION edMouse%%
    DIM wheel AS LONG, b AS _BYTE, rb AS _BYTE, changed AS _BYTE, rows AS LONG
    rows = edTR
    DO WHILE _MOUSEINPUT
        wheel = wheel + _MOUSEWHEEL
        b = _MOUSEBUTTON(1)
        edMouseY = _MOUSEY \ 16 + 1: edMouseX = _MOUSEX \ 8 + 1: edMousePY = _MOUSEY
        rb = _MOUSEBUTTON(2)
        IF rb AND edRightPrev = 0 AND edMouseDown = 0 AND b = 0 THEN
            edRightPrev = rb
            IF edMouseY >= 2 AND edMouseY <= edTR + 1 AND edMouseX < edCols THEN
                edRightClick
                edMouse%% = -1: EXIT FUNCTION
            END IF
        END IF
        edRightPrev = rb
        IF b = 0 THEN
            IF edMouseDown THEN changed = -1
            edMouseDown = 0
        ELSEIF edMouseDown = 0 THEN 'a press
            IF edMouseY = 1 THEN
                IF edMenuAt%(edMouseX) THEN edMenu edMenuAt%(edMouseX): edMouse%% = -1: EXIT FUNCTION
                edMouseDown = 2
            ELSEIF edMouseY <= edTR + 1 AND edMouseX >= edCols THEN
                edScrollClick
            ELSEIF edMouseY <= edTR + 1 AND edMouseX <= edGW THEN
                edGutterClick
                edMouseDown = 2
            ELSEIF edMouseY <= edTR + 1 THEN
                edMouseClick
                edMouseDown = 1
            ELSE
                edMouseDown = 2
            END IF
            changed = -1
        ELSEIF edMouseDown = 1 THEN
            edMouseDrag: changed = -1
        ELSEIF edMouseDown = 3 THEN
            edScrollDrag: changed = -1
        END IF
    LOOP
    'keep scrolling while dragging above or below the text, or holding
    'the scroll bar's arrows or track
    IF edMouseDown = 1 THEN
        IF edMouseY < 2 AND edTop > 1 THEN edTop = edTop - 1: edMouseDrag: changed = -1
        IF edMouseY > edTR + 1 AND edTop + rows - 1 < edN THEN edTop = edTop + 1: edMouseDrag: changed = -1
    END IF
    IF edMouseDown = 4 AND TIMER >= edRepT THEN edScrollBy edRepDir: edRepT = TIMER + .05: changed = -1
    IF wheel THEN edScrollBy wheel * 3: changed = -1
    'I-beam over the text, arrow elsewhere
    IF edMouseY >= 2 AND edMouseY <= edTR + 1 AND edMouseX > edGW AND edMouseX < edCols THEN
        IF edPointer <> 1 THEN _MOUSESHOW "TEXT": edPointer = 1
    ELSE
        IF edPointer <> 2 THEN _MOUSESHOW "DEFAULT": edPointer = 2
    END IF
    edMouse%% = changed
END FUNCTION

SUB edMouseToText (y AS LONG, x AS LONG)
    DIM my AS LONG
    my = edMouseY
    IF my < 2 THEN my = 2
    IF my > edTR + 1 THEN my = edTR + 1
    y = edTop + my - 2
    IF y > edN THEN y = edN
    x = edLeft + edMouseX - edGW
    IF edMouseX >= edCols THEN x = edLeft + edCols - 1 - edGW
    IF x < 1 THEN x = 1
    IF x > LEN(edL(y)) + 1 THEN x = LEN(edL(y)) + 1
END SUB

SUB edMouseClick
    DIM y AS LONG, x AS LONG
    edMouseToText y, x
    edLastKind = -1: edMsg$ = ""
    IF TIMER - edClickT < .4 AND TIMER >= edClickT AND y = edClickY AND x = edClickX THEN
        'double-click: select the word
        edCY = y: edCX = x
        edWordAt
        edClickT = 0
    ELSE
        IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN
            IF edSelOn = 0 THEN edSelOn = -1: edSY = edCY: edSX = edCX
        ELSE
            edSelOn = -1: edSY = y: edSX = x
        END IF
        edCY = y: edCX = x
        edClickT = TIMER: edClickY = y: edClickX = x
    END IF
    edWantX = edCX
END SUB

SUB edRightClick
    'right-click on the text or a line number: the cursor moves there
    '(unless the click is inside the selection) and the menu opens
    DIM y AS LONG, x AS LONG, sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG, inSel AS _BYTE
    edMsg$ = ""
    edMouseToText y, x
    IF edMouseX <= edGW THEN x = edFirstNonSpace&(y): IF x < 1 THEN x = 1
    IF edGetSel%(sy, sx, ey, ex) THEN
        inSel = (y > sy OR (y = sy AND x >= sx)) AND (y < ey OR (y = ey AND x <= ex))
    END IF
    IF inSel = 0 THEN edSelOn = 0: edCY = y: edCX = x: edWantX = x
    edContextMenu edMouseX, edMouseY
END SUB

SUB edGutterClick
    'a click on a line number sets or clears a breakpoint there;
    'Shift+click marks the line to be skipped
    DIM y AS LONG
    edMsg$ = ""
    y = edTop + edMouseY - 2
    IF y < 1 OR y > edN THEN EXIT SUB
    IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN dbgToggleMark y, MARK_SKIP ELSE dbgToggleMark y, MARK_BREAK
END SUB

SUB edMouseDrag
    DIM y AS LONG, x AS LONG
    edMouseToText y, x
    IF edSelOn = 0 THEN edSelOn = -1: edSY = edCY: edSX = edCX
    edCY = y: edCX = x: edWantX = edCX
END SUB

SUB edWordAt
    DIM a AS LONG, b AS LONG
    a = edCX: b = edCX
    DO WHILE a > 1 AND edIsWordChar%%(MID$(edL(edCY), a - 1, 1)): a = a - 1: LOOP
    DO WHILE b <= LEN(edL(edCY)) AND edIsWordChar%%(MID$(edL(edCY), b, 1)): b = b + 1: LOOP
    edSelOn = -1: edSY = edCY: edSX = a: edCX = b
END SUB

'---------------------------------------------------------------- drawing
SUB printCode (s$)
    'prints a line of code in syntax colours, without a newline (used by LIST)
    DIM c$, i AS LONG, j AS LONG
    IF headless THEN PRINT s$;: EXIT SUB
    c$ = edColors$(s$)
    i = 1
    DO WHILE i <= LEN(s$)
        j = i
        DO WHILE j < LEN(s$)
            IF ASC(c$, j + 1) <> ASC(c$, i) THEN EXIT DO
            j = j + 1
        LOOP
        codeColor ASC(c$, i)
        PRINT MID$(s$, i, j - i + 1);
        i = j + 1
    LOOP
    codeColor EC_TEXT
END SUB

SUB codeColor (slot AS INTEGER)
    'the editor's colours on whatever screen the prompt is using
    DIM c AS _UNSIGNED LONG, p AS _UNSIGNED LONG
    p = edPal(slot)
    SELECT CASE _PIXELSIZE(_DEST)
        CASE 4 'exact colours
            COLOR p
        CASE 0 'text mode: the standard 16 colours
            SELECT CASE slot
                CASE EC_KEYWORD: COLOR 11
                CASE EC_NUMBER: COLOR 12
                CASE EC_STRING: COLOR 14
                CASE EC_COMMENT: COLOR 3
                CASE EC_META: COLOR 10
                CASE EC_LABEL: COLOR 15
                CASE EC_GUTTER: COLOR 8
                CASE ELSE: COLOR 7
            END SELECT
        CASE ELSE 'palette graphics: the nearest colour the screen has
            c = _RGB(_RED32(p), _GREEN32(p), _BLUE32(p))
            IF c = _BACKGROUNDCOLOR THEN c = _RGB(255, 255, 255)
            IF c = _BACKGROUNDCOLOR THEN c = _RGB(0, 0, 0)
            COLOR c
    END SELECT
END SUB

SUB codeBackground
    'a solid dark background so the colours show on any screen
    IF _PIXELSIZE(_DEST) = 4 THEN COLOR , _RGB32(0, 0, 0) ELSE COLOR , _RGB(0, 0, 0)
END SUB

SUB edSetPalette
    edPal(EC_BG) = _RGB32(0, 0, 39)
    edPal(EC_CURLINE) = _RGB32(0, 40, 70)
    edPal(EC_SEL) = _RGB32(40, 80, 150)
    edPal(EC_ERRLINE) = _RGB32(110, 20, 30)
    edPal(EC_BAR) = _RGB32(170, 170, 170)
    edPal(EC_MATCH) = _RGB32(110, 90, 0)
    edPal(EC_BARTEXT) = _RGB32(0, 0, 0)
    edPal(EC_TEXT) = _RGB32(216, 216, 216)
    edPal(EC_GUTTER) = _RGB32(90, 100, 140)
    edPal(EC_KEYWORD) = _RGB32(90, 170, 255)
    edPal(EC_NUMBER) = _RGB32(230, 120, 100)
    edPal(EC_STRING) = _RGB32(255, 175, 40)
    edPal(EC_COMMENT) = _RGB32(120, 150, 150)
    edPal(EC_META) = _RGB32(90, 210, 90)
    edPal(EC_LABEL) = _RGB32(240, 220, 120)
    edPal(EC_BRIGHT) = _RGB32(255, 255, 255)
    edPal(EC_HOTKEY) = _RGB32(150, 0, 0)
    edPal(EC_TRACK) = _RGB32(20, 28, 70)
    edPal(EC_THUMB) = _RGB32(120, 135, 185)
    edPal(EC_THUMBHOT) = _RGB32(190, 200, 235)
    edPal(EC_BUTTON) = _RGB32(90, 100, 135)
    edPal(EC_EXECLINE) = _RGB32(85, 70, 0)
    edPal(EC_BPDOT) = _RGB32(230, 40, 40)
END SUB

SUB edDot (row AS LONG)
    'a breakpoint: a red dot in the gutter's first column
    DIM cx AS LONG, cy AS LONG, dy AS LONG, dx AS LONG
    cx = 4: cy = (row - 1) * 16 + 8
    FOR dy = -3 TO 3
        dx = INT(SQR(10 - dy * dy))
        LINE (cx - dx, cy + dy)-(cx + dx, cy + dy), edPal(EC_BPDOT)
    NEXT
END SUB

SUB edColor (fg AS INTEGER, bg AS INTEGER)
    COLOR edPal(fg), edPal(bg)
END SUB

SUB edPut (col AS LONG, row AS LONG, t$)
    'prints t$ at a text cell (the editor screen is a graphics image)
    _PRINTSTRING ((col - 1) * 8, (row - 1) * 16), t$
END SUB

SUB edBar (col AS LONG, row AS LONG, c AS INTEGER)
    'a thin text cursor at the left edge of a cell
    LINE ((col - 1) * 8, (row - 1) * 16)-((col - 1) * 8 + 1, row * 16 - 1), edPal(c), BF
END SUB

FUNCTION edBlinkPhase%%
    'cursor visible? Solid while typing, then blinks every half second
    DIM t AS DOUBLE
    t = TIMER - edBlinkT
    IF t < 0 THEN edBlinkT = TIMER: t = 0 'midnight
    edBlinkPhase%% = (INT(t * 2) MOD 2) = 0
END FUNCTION

FUNCTION edResized%%
    'follows the window size; the grid needs at least 40x10 cells
    DIM w AS LONG, h AS LONG, old AS LONG
    IF _RESIZE = 0 THEN EXIT FUNCTION
    w = _RESIZEWIDTH \ 8: h = _RESIZEHEIGHT \ 16
    IF w < 40 THEN w = 40
    IF h < 10 THEN h = 10
    IF w = edCols AND h = edRows THEN EXIT FUNCTION
    edCols = w: edRows = h
    old = edImg
    edImg = _NEWIMAGE(edCols * 8, edRows * 16, 32)
    SCREEN edImg
    _FREEIMAGE old
    edEnsureVisible
    edResized%% = -1
END FUNCTION

SUB edCalcGutter
    'gutter: breakpoint/skip mark, line number, execution arrow, space
    edGW = LEN(_TRIM$(STR$(edN)))
    IF edGW < 3 THEN edGW = 3
    edGW = edGW + 3
    edTR = edRows - 2 - dbgPanelRows%
    IF edTR < 1 THEN edTR = 1
END SUB

SUB edEnsureVisible
    DIM rows AS LONG, tw AS LONG
    edCalcGutter
    rows = edTR: tw = edCols - edGW - 1
    IF edCY < edTop THEN edTop = edCY
    IF edCY > edTop + rows - 1 THEN edTop = edCY - rows + 1
    IF edTop > edN THEN edTop = edN
    IF edTop < 1 THEN edTop = 1
    IF edCX - 1 < edLeft THEN edLeft = edCX - 1
    IF edCX - 1 >= edLeft + tw THEN edLeft = edCX - tw
    IF edLeft < 0 THEN edLeft = 0
END SUB

FUNCTION edColors$ (s$)
    'one colour (palette slot) per character of s$
    DIM c$, i AS LONG, j AS LONG, n AS LONG, ch AS INTEGER, w$, col AS INTEGER
    DIM stmtStart AS _BYTE, lineStart AS LONG
    n = LEN(s$)
    c$ = STRING$(n, EC_TEXT)
    stmtStart = -1
    i = 1
    DO WHILE i <= n
        ch = ASC(s$, i)
        SELECT CASE ch
            CASE 34 'string
                j = INSTR(i + 1, s$, CHR$(34))
                IF j = 0 THEN j = n
                MID$(c$, i) = STRING$(j - i + 1, EC_STRING)
                i = j + 1: stmtStart = 0
            CASE 39 'comment, or '$metacommand
                IF MID$(s$, i + 1, 1) = "$" THEN col = EC_META ELSE col = EC_COMMENT
                MID$(c$, i) = STRING$(n - i + 1, col)
                EXIT DO
            CASE 36 '$metacommand
                IF stmtStart THEN MID$(c$, i) = STRING$(n - i + 1, EC_META): EXIT DO
                i = i + 1
            CASE 48 TO 57, 46, 38 'numbers, &H &O &B
                j = i
                IF ch = 38 THEN
                    IF INSTR("HhOoBb", MID$(s$, i + 1, 1)) = 0 OR i = n THEN i = i + 1: _CONTINUE
                    j = i + 2
                    DO WHILE j <= n AND edIsWordChar%%(MID$(s$, j, 1)): j = j + 1: LOOP
                ELSE
                    IF ch = 46 AND (i = n OR INSTR("0123456789", MID$(s$, i + 1, 1)) = 0) THEN i = i + 1: _CONTINUE
                    DO WHILE j <= n AND INSTR("0123456789.", MID$(s$, j, 1)) > 0 AND MID$(s$, j, 1) <> "": j = j + 1: LOOP
                    IF INSTR("EeDd", MID$(s$, j, 1)) > 0 AND MID$(s$, j, 1) <> "" THEN
                        IF INSTR("0123456789+-", MID$(s$, j + 1, 1)) > 0 AND MID$(s$, j + 1, 1) <> "" THEN
                            j = j + 2
                            DO WHILE j <= n AND INSTR("0123456789", MID$(s$, j, 1)) > 0: j = j + 1: LOOP
                        END IF
                    END IF
                END IF
                DO WHILE j <= n AND INSTR("!#%&~`", MID$(s$, j, 1)) > 0 AND MID$(s$, j, 1) <> "": j = j + 1: LOOP
                MID$(c$, i) = STRING$(j - i, EC_NUMBER)
                i = j: stmtStart = 0
            CASE 65 TO 90, 97 TO 122, 95 'names
                j = i + 1
                DO WHILE j <= n
                    IF edIsWordChar%%(MID$(s$, j, 1)) = 0 AND MID$(s$, j, 1) <> "." THEN EXIT DO
                    j = j + 1
                LOOP
                IF INSTR("%&!#~`", MID$(s$, j, 1)) > 0 AND MID$(s$, j, 1) <> "" THEN j = j + 1
                w$ = UCASE$(MID$(s$, i, j - i))
                IF w$ = "REM" THEN MID$(c$, i) = STRING$(n - i + 1, EC_COMMENT): EXIT DO
                IF INSTR(edKeywords$, " " + w$ + " ") THEN
                    MID$(c$, i) = STRING$(j - i, EC_KEYWORD)
                ELSEIF lineStart = 0 AND MID$(s$, j, 1) = ":" THEN
                    MID$(c$, i) = STRING$(j - i + 1, EC_LABEL)
                END IF
                i = j: stmtStart = 0
            CASE 58 ':'
                stmtStart = -1: i = i + 1
            CASE ELSE
                i = i + 1
        END SELECT
        IF ch <> 32 THEN lineStart = 1
    LOOP
    edColors$ = c$
END FUNCTION

SUB edDraw
    DIM r AS LONG, y AS LONG, x AS LONG, p AS LONG, s$, c$, m$, t$, f$, rt$
    DIM hasSel AS _BYTE, sy AS LONG, sx AS LONG, ey AS LONG, ex AS LONG
    DIM tw AS LONG, lineBg AS INTEGER, fg AS INTEGER, bg AS INTEGER, runFg AS INTEGER, runBg AS INTEGER
    DIM run$, runX AS LONG, i AS LONG, needle$, sel AS _BYTE

    edCalcGutter
    tw = edCols - edGW - 1
    hasSel = edGetSel%(sy, sx, ey, ex)
    needle$ = UCASE$(edFind$)

    'menu bar
    f$ = loadedFile$
    IF f$ = "" THEN f$ = "Untitled"
    f$ = MID$(f$, _INSTRREV(f$, "/") + 1)
    IF edModified%% THEN f$ = f$ + " *"
    IF dbgPaused THEN setTitle "Debugging " + f$ + " - paused at line" + STR$(dbgExecLine) ELSE setTitle "Editing " + f$
    edDrawMenuBar 0

    FOR r = 2 TO edTR + 1
        y = edTop + r - 2
        IF y > edN THEN
            edColor EC_GUTTER, EC_BG
            edPut 1, r, SPACE$(edCols)
            _CONTINUE
        END IF
        lineBg = EC_BG
        IF y = edErrLine THEN lineBg = EC_ERRLINE ELSE IF y = edCY THEN lineBg = EC_CURLINE
        IF dbgPaused AND y = dbgExecLine THEN lineBg = EC_EXECLINE
        t$ = _TRIM$(STR$(y))
        IF y = edCY THEN edColor EC_BRIGHT, EC_BG ELSE edColor EC_GUTTER, EC_BG
        edPut 1, r, SPACE$(edGW - 2 - LEN(t$)) + t$ + "  "
        IF y <= UBOUND(edMark) THEN
            IF edMark(y) AND MARK_BREAK THEN edDot r
            IF edMark(y) AND MARK_SKIP THEN edColor EC_STRING, EC_BG: edPut 1, r, "!"
        END IF
        IF dbgPaused AND y = dbgExecLine THEN edColor EC_LABEL, EC_BG: edPut edGW - 1, r, CHR$(16)

        s$ = edL(y)
        c$ = edColors$(s$)
        m$ = ""
        IF LEN(needle$) THEN
            m$ = STRING$(LEN(s$), 0)
            i = INSTR(UCASE$(s$), needle$)
            DO WHILE i
                MID$(m$, i) = STRING$(LEN(needle$), 1)
                i = INSTR(i + LEN(needle$), UCASE$(s$), needle$)
            LOOP
        END IF

        run$ = "": runX = edGW + 1
        FOR x = 1 TO tw
            p = edLeft + x
            IF p <= LEN(s$) THEN
                t$ = MID$(s$, p, 1): fg = ASC(c$, p)
            ELSE
                t$ = " ": fg = EC_TEXT
            END IF
            bg = lineBg
            IF LEN(m$) THEN
                IF p <= LEN(m$) THEN IF ASC(m$, p) THEN bg = EC_MATCH
            END IF
            IF hasSel AND y >= sy AND y <= ey THEN
                sel = -1
                IF y = sy AND p < sx THEN sel = 0
                IF y = ey AND p >= ex THEN sel = 0
                IF p > LEN(s$) + 1 OR (p = LEN(s$) + 1 AND y = ey) THEN sel = 0
                IF sel THEN bg = EC_SEL: IF fg = EC_COMMENT THEN fg = EC_TEXT
            END IF
            IF x > 1 AND (fg <> runFg OR bg <> runBg) THEN
                edColor runFg, runBg: edPut runX, r, run$
                run$ = "": runX = edGW + x
            END IF
            run$ = run$ + t$: runFg = fg: runBg = bg
        NEXT
        edColor runFg, runBg: edPut runX, r, run$
        IF edLeft > 0 THEN edColor EC_GUTTER, EC_BG: edPut edGW, r, CHR$(17)
    NEXT
    edDrawScrollbar
    IF edTR + 2 < edRows THEN dbgDrawPanel edTR + 2, edRows - edTR - 2

    'status bar
    rt$ = "Ln " + _TRIM$(STR$(edCY)) + "/" + _TRIM$(STR$(edN)) + "  Col " + _TRIM$(STR$(edCX)) + "  "
    IF edIns THEN rt$ = rt$ + "INS " ELSE rt$ = rt$ + "OVR "
    IF LEN(edMsg$) THEN
        t$ = " " + edMsg$
        IF edErrLine THEN edColor EC_BRIGHT, EC_ERRLINE ELSE edColor EC_BARTEXT, EC_BAR
    ELSE
        'as many key hints as fit
        t$ = ""
        IF dbgPaused THEN
            f$ = "F5 Continue|F7 Step|F8 Step Over|F6 Step Out|F9 Breakpoint|^W Variables|Esc Stop|"
        ELSE
            f$ = "Alt Menu|^S Save|F5 Run|F8 Step|F9 Breakpoint|F4 Output|Esc Close|"
        END IF
        DO WHILE LEN(f$)
            i = INSTR(f$, "|")
            IF LEN(t$) + i + 2 > edCols - LEN(rt$) THEN EXIT DO
            t$ = t$ + " " + LEFT$(f$, i - 1) + " "
            f$ = MID$(f$, i + 1)
        LOOP
        edColor EC_BARTEXT, EC_BAR
    END IF
    t$ = LEFT$(t$ + SPACE$(edCols), edCols - LEN(rt$))
    edPut 1, edRows, t$
    edColor EC_BARTEXT, EC_BAR
    edPut edCols - LEN(rt$) + 1, edRows, rt$

    'cursor
    'cursor: a blinking bar (a block when overwriting)
    edBlinkOn = edBlinkPhase%%
    y = edCY - edTop + 2: x = edCX - edLeft + edGW
    IF edBlinkOn AND edModal = 0 AND dbgPaused = 0 AND y >= 2 AND y <= edTR + 1 AND x > edGW AND x < edCols THEN
        IF edIns THEN
            edBar x, y, EC_BRIGHT
        ELSE
            LINE ((x - 1) * 8, (y - 1) * 16)-(x * 8 - 1, y * 16 - 1), _RGBA32(255, 255, 255, 110), BF
        END IF
    END IF
    'the caller shows it with _DISPLAY, after drawing anything on top
END SUB
