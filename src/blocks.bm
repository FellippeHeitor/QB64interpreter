'blocks.bm - compiles program text into a flat list of statements
'
'Each line is split into statements. Block statements are linked to their
'partners (DO<->LOOP, FOR<->NEXT, WHILE<->WEND, IF->ELSEIF->ELSE->END IF,
'SELECT CASE->CASE->END SELECT, SUB<->END SUB) so the runner can jump
'straight to them. A single-line IF becomes a conditional jump around its
'statements, so anything (even FOR...NEXT) can follow THEN.
'Labels, line numbers, DATA items and SUB/FUNCTION headers are collected too.

FUNCTION nextStmtSep& (text$, start AS LONG)
    'position of the next ":" that separates statements, or 0.
    'Colons inside quotes or after a comment (') don't count.
    DIM i AS LONG, c AS INTEGER, quote AS _BYTE
    FOR i = start TO LEN(text$)
        c = ASC(text$, i)
        IF c = 34 THEN
            quote = NOT quote
        ELSEIF quote = 0 THEN
            IF c = 58 THEN nextStmtSep& = i: EXIT FUNCTION
            IF c = 39 THEN EXIT FUNCTION
        END IF
    NEXT
END FUNCTION

FUNCTION stripComment$ (s$)
    'removes a trailing ' comment (outside quotes)
    DIM i AS LONG, c AS INTEGER, quote AS _BYTE
    FOR i = 1 TO LEN(s$)
        c = ASC(s$, i)
        IF c = 34 THEN quote = NOT quote
        IF c = 39 AND quote = 0 THEN stripComment$ = _TRIM$(LEFT$(s$, i - 1)): EXIT FUNCTION
    NEXT
    stripComment$ = _TRIM$(s$)
END FUNCTION

FUNCTION compileProgram%% (src() AS STRING)
    DIM ln AS LONG, i AS LONG

    stmtCount = 0: procCount = 0: labelCount = 0: dataCount = 0
    csp = 0: cErr$ = "": cProc = 0
    REDIM stmts(100) AS stmtType
    FOR i = 1 TO 26: defType(i) = varTypeSINGLE: NEXT

    FOR ln = 1 TO UBOUND(src)
        compileLine src(ln), ln
        IF LEN(cErr$) THEN EXIT FOR
    NEXT

    IF cErr$ = "" AND csp > 0 THEN
        SELECT CASE stmts(cStack(csp)).kind
            CASE stDO: cErr$ = "DO without LOOP"
            CASE stFOR: cErr$ = "FOR without NEXT"
            CASE stIF: cErr$ = "IF without END IF"
            CASE stWHILE: cErr$ = "WHILE without WEND"
            CASE stSELECT: cErr$ = "SELECT CASE without END SELECT"
            CASE stSUB: cErr$ = "SUB/FUNCTION without END SUB/END FUNCTION"
        END SELECT
        cErrLine = stmts(cStack(csp)).lineNo
    END IF

    IF LEN(cErr$) THEN
        PRINT cErr$;
        IF cErrLine > 0 AND immediateRun = 0 THEN PRINT " on line"; cErrLine ELSE PRINT
        lineThatErrored = cErrLine
        EXIT FUNCTION
    END IF

    REDIM forVar(stmtCount) AS LONG, forFinal(stmtCount) AS _FLOAT, forStep(stmtCount) AS _FLOAT
    dataPtr = 1
    compileProgram%% = true
END FUNCTION

SUB compileFail (msg$, ln AS LONG)
    IF cErr$ = "" THEN cErr$ = msg$: cErrLine = ln
END SUB

FUNCTION isStmtKeyword%% (w$)
    'single words that are statements, not labels, when followed by ":"
    SELECT CASE w$
        CASE "CLS", "BEEP", "END", "STOP", "SYSTEM", "RETURN", "PRINT", "LOOP", "DO", "NEXT", "ELSE", "WEND"
        CASE "RANDOMIZE", "SLEEP", "_DISPLAY", "_CONTINUE", "RESTORE", "ENDIF", "CLEAR", "_AUTODISPLAY"
        CASE "CLOSE", "PALETTE", "_KEYCLEAR", "_MOUSESHOW", "_MOUSEHIDE", "FILES", "INPUT", "WRITE"
        CASE ELSE: EXIT FUNCTION
    END SELECT
    isStmtKeyword%% = true
END FUNCTION

SUB compileLine (t$, ln AS LONG)
    DIM rest$, w$, sep AS LONG, k AS LONG, i AS LONG

    rest$ = _TRIM$(t$)
    IF LEN(rest$) = 0 THEN EXIT SUB
    IF LEFT$(rest$, 1) = "$" THEN EXIT SUB 'metacommand ($CONSOLE, ...)

    'line number: "10 PRINT x"
    k = INSTR(rest$ + " ", " ")
    w$ = LEFT$(rest$, k - 1)
    IF isNumber(w$) THEN
        addLabel w$
        rest$ = _TRIM$(MID$(rest$, k))
    END IF

    'label: "start:"
    sep = nextStmtSep(rest$, 1)
    IF sep > 1 THEN
        w$ = UCASE$(_TRIM$(LEFT$(rest$, sep - 1)))
        IF INSTR(w$, " ") = 0 AND isStmtKeyword(w$) = 0 THEN
            FOR i = 1 TO LEN(w$)
                IF isIdentChar(ASC(w$, i)) = 0 THEN EXIT FOR
            NEXT
            IF i > LEN(w$) THEN
                addLabel w$
                rest$ = MID$(rest$, sep + 1)
            END IF
        END IF
    END IF

    compileStmts rest$, ln
END SUB

SUB compileStmts (text$, ln AS LONG)
    DIM t$, u$, sep AS LONG, piece$, pu$
    t$ = text$
    DO
        t$ = _TRIM$(t$)
        IF LEN(t$) = 0 THEN EXIT DO
        u$ = UCASE$(t$)
        IF LEFT$(u$, 1) = "'" OR LEFT$(u$, 4) = "REM " OR u$ = "REM" THEN EXIT DO
        sep = nextStmtSep(t$, 1)
        IF sep THEN piece$ = LEFT$(t$, sep - 1) ELSE piece$ = t$
        piece$ = stripComment$(piece$)
        pu$ = UCASE$(piece$)
        IF LEFT$(pu$, 3) = "IF " AND RIGHT$(pu$, 5) <> " THEN" THEN
            'single-line IF: it owns the rest of the line
            compileSingleIf stripComment$(t$), ln
            EXIT DO
        END IF
        IF LEN(piece$) THEN compileOne piece$, ln
        IF LEN(cErr$) OR sep = 0 THEN EXIT DO
        t$ = MID$(t$, sep + 1)
    LOOP
END SUB

SUB compileSingleIf (t$, ln AS LONG)
    DIM u$, thenPos AS LONG, gotoForm AS _BYTE, cond$, body$, thenPart$, elsePart$
    DIM e AS LONG, hasElse AS _BYTE, sif AS LONG, sk AS LONG

    u$ = UCASE$(t$)
    thenPos = Find(1, u$, " THEN ")
    IF thenPos = 0 THEN
        thenPos = Find(1, u$, " GOTO ")
        IF thenPos = 0 THEN compileFail "Expected IF ... THEN", ln: EXIT SUB
        gotoForm = true
    END IF
    cond$ = MID$(t$, 4, thenPos - 4)
    body$ = _TRIM$(MID$(t$, thenPos + 6))
    IF gotoForm THEN body$ = "GOTO " + body$

    thenPart$ = body$
    IF UCASE$(LEFT$(body$, 3)) <> "IF " THEN 'a nested IF keeps the ELSE
        e = Find(1, UCASE$(body$), " ELSE ")
        IF e = 0 THEN e = Find(1, UCASE$(body$), ":ELSE ")
        IF e THEN
            hasElse = true
            thenPart$ = _TRIM$(LEFT$(body$, e - 1))
            elsePart$ = _TRIM$(MID$(body$, e + 6))
        END IF
    END IF
    IF isNumber(thenPart$) THEN thenPart$ = "GOTO " + thenPart$
    IF isNumber(elsePart$) THEN elsePart$ = "GOTO " + elsePart$

    sif = emitStmt(stSIF, cond$, ln)
    compileStmts thenPart$, ln
    IF hasElse THEN
        sk = emitStmt(stSKIP, "", ln)
        stmts(sif).match = stmtCount + 1
        compileStmts elsePart$, ln
        stmts(sk).match = stmtCount + 1
    ELSE
        stmts(sif).match = stmtCount + 1
    END IF
END SUB

FUNCTION emitStmt& (kind AS _BYTE, text$, ln AS LONG)
    DIM i AS LONG, k AS LONG
    stmtCount = stmtCount + 1
    IF stmtCount > UBOUND(stmts) THEN REDIM _PRESERVE stmts(stmtCount + 100) AS stmtType
    i = stmtCount
    stmts(i).lineNo = ln
    stmts(i).text = _TRIM$(text$)
    stmts(i).kind = kind
    stmts(i).match = 0: stmts(i).nextBranch = 0: stmts(i).endIdx = 0
    stmts(i).nVars = 0: stmts(i).hasCond = false
    stmts(i).proc = cProc
    stmts(i).encDo = 0: stmts(i).encFor = 0: stmts(i).encWhile = 0
    FOR k = csp TO 1 STEP -1
        SELECT CASE stmts(cStack(k)).kind
            CASE stDO: IF stmts(i).encDo = 0 THEN stmts(i).encDo = cStack(k)
            CASE stFOR: IF stmts(i).encFor = 0 THEN stmts(i).encFor = cStack(k)
            CASE stWHILE: IF stmts(i).encWhile = 0 THEN stmts(i).encWhile = cStack(k)
        END SELECT
    NEXT
    emitStmt& = i
END FUNCTION

FUNCTION classify%% (u$)
    classify%% = stOTHER
    IF u$ = "DO" OR LEFT$(u$, 3) = "DO " THEN classify%% = stDO
    IF u$ = "LOOP" OR LEFT$(u$, 5) = "LOOP " THEN classify%% = stLOOP
    IF LEFT$(u$, 4) = "FOR " THEN classify%% = stFOR
    IF u$ = "NEXT" OR LEFT$(u$, 5) = "NEXT " THEN classify%% = stNEXT
    IF LEFT$(u$, 3) = "IF " AND RIGHT$(u$, 5) = " THEN" THEN classify%% = stIF
    IF LEFT$(u$, 7) = "ELSEIF " THEN classify%% = stELSEIF
    IF u$ = "ELSE" OR LEFT$(u$, 5) = "ELSE " THEN classify%% = stELSE
    IF u$ = "END IF" OR u$ = "ENDIF" THEN classify%% = stENDIF
    IF LEFT$(u$, 6) = "WHILE " THEN classify%% = stWHILE
    IF u$ = "WEND" THEN classify%% = stWEND
    IF LEFT$(u$, 12) = "SELECT CASE " THEN classify%% = stSELECT
    IF LEFT$(u$, 5) = "CASE " THEN classify%% = stCASE
    IF u$ = "END SELECT" THEN classify%% = stENDSELECT
    IF LEFT$(u$, 4) = "SUB " OR LEFT$(u$, 9) = "FUNCTION " THEN classify%% = stSUB
    IF u$ = "END SUB" OR u$ = "END FUNCTION" THEN classify%% = stENDSUB
END FUNCTION

SUB compileOne (piece$, ln AS LONG)
    DIM u$, kind AS _BYTE, i AS LONG, k AS LONG, f AS LONG, n AS LONG, b AS LONG
    REDIM names$(0)

    u$ = UCASE$(piece$)

    'statements that only matter while compiling
    IF LEFT$(u$, 5) = "DATA " OR u$ = "DATA" THEN addData MID$(piece$, 5): EXIT SUB
    IF LEFT$(u$, 8) = "DECLARE " OR LEFT$(u$, 7) = "OPTION " THEN EXIT SUB
    IF LEFT$(u$, 3) = "DEF" AND MID$(u$, 7, 1) = " " THEN
        SELECT CASE LEFT$(u$, 6)
            CASE "DEFINT": setDefType MID$(u$, 8), varTypeINTEGER: EXIT SUB
            CASE "DEFLNG": setDefType MID$(u$, 8), varTypeLONG: EXIT SUB
            CASE "DEFSNG": setDefType MID$(u$, 8), varTypeSINGLE: EXIT SUB
            CASE "DEFDBL": setDefType MID$(u$, 8), varTypeDOUBLE: EXIT SUB
            CASE "DEFSTR": setDefType MID$(u$, 8), varTypeSTRING: EXIT SUB
        END SELECT
    END IF

    kind = classify(u$)

    'statements after ELSE on the same line (block IF)
    IF kind = stELSE AND u$ <> "ELSE" THEN
        compileOne "ELSE", ln
        compileStmts MID$(piece$, 6), ln
        EXIT SUB
    END IF

    IF kind = stSUB AND csp > 0 THEN compileFail "SUB/FUNCTION can't be inside a block", ln: EXIT SUB
    IF kind = stSUB AND cProc > 0 THEN compileFail "SUB/FUNCTION can't be nested", ln: EXIT SUB
    IF LEFT$(u$, 9) = "EXIT SUB" OR LEFT$(u$, 13) = "EXIT FUNCTION" THEN
        IF cProc = 0 THEN compileFail u$ + " outside SUB/FUNCTION", ln: EXIT SUB
    END IF

    IF kind = stSUB THEN addProc piece$, ln: IF LEN(cErr$) THEN EXIT SUB
    i = emitStmt(kind, piece$, ln)

    SELECT CASE kind
        CASE stDO, stFOR, stIF, stWHILE, stSELECT, stSUB
            IF csp = UBOUND(cStack) THEN compileFail "Blocks nested too deeply", ln: EXIT SUB
            csp = csp + 1
            cStack(csp) = i
            cLast(csp) = i
            IF kind = stDO THEN stmts(i).hasCond = (u$ <> "DO")
            IF kind = stSUB THEN procs(cProc).startIdx = i
        CASE stLOOP
            stmts(i).hasCond = (u$ <> "LOOP")
            IF topKind <> stDO THEN compileFail "LOOP without DO", ln: EXIT SUB
            IF stmts(i).hasCond AND stmts(cStack(csp)).hasCond THEN compileFail "DO and LOOP can't both have a condition", ln: EXIT SUB
            linkPop i
        CASE stWEND
            IF topKind <> stWHILE THEN compileFail "WEND without WHILE", ln: EXIT SUB
            linkPop i
        CASE stENDSUB
            IF topKind <> stSUB THEN compileFail u$ + " without SUB/FUNCTION", ln: EXIT SUB
            IF (u$ = "END FUNCTION") <> (procs(cProc).isFunc <> 0) THEN compileFail "Mismatched " + u$, ln: EXIT SUB
            procs(cProc).endIdx = i
            linkPop i
            cProc = 0
        CASE stNEXT
            IF u$ = "NEXT" THEN
                n = 1
            ELSE
                n = splitArgs(MID$(u$, 6), names$())
            END IF
            stmts(i).nVars = n
            FOR k = 1 TO n
                IF topKind <> stFOR THEN compileFail "NEXT without FOR", ln: EXIT SUB
                f = cStack(csp)
                IF u$ <> "NEXT" THEN
                    IF names$(k) <> forVarName$(f) THEN compileFail "NEXT variable doesn't match FOR", ln: EXIT SUB
                END IF
                stmts(f).match = i
                IF k = 1 THEN stmts(i).match = f
                csp = csp - 1
            NEXT
        CASE stELSEIF, stELSE
            IF topKind <> stIF THEN compileFail "ELSE without IF", ln: EXIT SUB
            IF stmts(cLast(csp)).kind = stELSE THEN compileFail "ELSE must be the last branch of IF", ln: EXIT SUB
            IF kind = stELSEIF AND RIGHT$(u$, 5) <> " THEN" THEN compileFail "Expected ELSEIF condition THEN", ln: EXIT SUB
            stmts(cLast(csp)).nextBranch = i
            cLast(csp) = i
        CASE stCASE
            IF topKind <> stSELECT THEN compileFail "CASE without SELECT CASE", ln: EXIT SUB
            IF UCASE$(_TRIM$(stmts(cLast(csp)).text)) = "CASE ELSE" THEN compileFail "CASE ELSE must be the last CASE", ln: EXIT SUB
            stmts(cLast(csp)).nextBranch = i
            cLast(csp) = i
        CASE stENDIF, stENDSELECT
            IF kind = stENDIF AND topKind <> stIF THEN compileFail "END IF without block IF", ln: EXIT SUB
            IF kind = stENDSELECT AND topKind <> stSELECT THEN compileFail "END SELECT without SELECT CASE", ln: EXIT SUB
            stmts(cLast(csp)).nextBranch = i
            b = cStack(csp)
            DO WHILE b <> i
                stmts(b).endIdx = i
                b = stmts(b).nextBranch
            LOOP
            stmts(i).match = cStack(csp)
            csp = csp - 1
    END SELECT
END SUB

FUNCTION topKind%%
    IF csp = 0 THEN topKind%% = -1 ELSE topKind%% = stmts(cStack(csp)).kind
END FUNCTION

SUB linkPop (i AS LONG)
    stmts(i).match = cStack(csp)
    stmts(cStack(csp)).match = i
    csp = csp - 1
END SUB

SUB setDefType (letters$, t AS _BYTE)
    'DEFINT A-Z, DEFSTR S, ...
    DIM i AS LONG, a AS INTEGER, b AS INTEGER, c AS INTEGER
    REDIM r$(0)
    FOR i = 1 TO splitArgs(letters$, r$())
        a = ASC(r$(i) + "?") - 64
        b = a
        IF INSTR(r$(i), "-") THEN b = ASC(_TRIM$(MID$(r$(i), INSTR(r$(i), "-") + 1)) + "?") - 64
        FOR c = a TO b
            IF c >= 1 AND c <= 26 THEN defType(c) = t
        NEXT
    NEXT
END SUB

SUB addProc (header$, ln AS LONG)
    'SUB name [(params)] / FUNCTION name[suffix] [(params)]
    DIM t$, isFunc AS _BYTE, p AS LONG, q AS LONG, nm$, i AS LONG

    t$ = _TRIM$(header$)
    isFunc = (UCASE$(LEFT$(t$, 9)) = "FUNCTION ")
    IF isFunc THEN t$ = _TRIM$(MID$(t$, 10)) ELSE t$ = _TRIM$(MID$(t$, 5))
    IF UCASE$(RIGHT$(t$, 7)) = " STATIC" THEN t$ = _TRIM$(LEFT$(t$, LEN(t$) - 7))

    p = INSTR(t$, "(")
    IF p THEN
        nm$ = _TRIM$(LEFT$(t$, p - 1))
        q = _INSTRREV(t$, ")")
        IF q < p THEN compileFail "Expected )", ln: EXIT SUB
    ELSE
        nm$ = t$
    END IF
    IF validName(nm$) = 0 THEN compileFail "Bad SUB/FUNCTION name", ln: EXIT SUB
    FOR i = 1 TO procCount
        IF procs(i).name = baseName$(nm$) THEN compileFail "Duplicate definition", ln: EXIT SUB
    NEXT

    procCount = procCount + 1
    IF procCount > UBOUND(procs) THEN REDIM _PRESERVE procs(procCount + 20) AS procType
    procs(procCount).name = baseName$(nm$)
    procs(procCount).isFunc = isFunc
    procs(procCount).retType = detectType(nm$)
    IF p THEN procs(procCount).params = MID$(t$, p + 1, q - p - 1) ELSE procs(procCount).params = ""
    cProc = procCount
END SUB

FUNCTION findProc& (nm$, wantFunc AS _BYTE)
    DIM i AS LONG, b$
    b$ = baseName$(_TRIM$(nm$))
    FOR i = 1 TO procCount
        IF procs(i).name = b$ AND procs(i).isFunc = wantFunc THEN findProc& = i: EXIT FUNCTION
    NEXT
END FUNCTION

SUB addLabel (nm$)
    labelCount = labelCount + 1
    IF labelCount > UBOUND(labelName) THEN
        REDIM _PRESERVE labelName(labelCount + 50) AS STRING
        REDIM _PRESERVE labelStmt(labelCount + 50) AS LONG
        REDIM _PRESERVE labelData(labelCount + 50) AS LONG
    END IF
    labelData(labelCount) = dataCount + 1 'first DATA item after the label
    labelName(labelCount) = UCASE$(nm$)
    labelStmt(labelCount) = stmtCount + 1 'the next statement compiled
END SUB

FUNCTION findLabelData& (nm$)
    'the DATA item RESTORE label starts at (-1 when there's no such label)
    DIM i AS LONG, n$
    n$ = UCASE$(_TRIM$(nm$))
    FOR i = 1 TO labelCount
        IF labelName(i) = n$ THEN findLabelData& = labelData(i): EXIT FUNCTION
    NEXT
    findLabelData& = -1
END FUNCTION

FUNCTION findLabel& (nm$)
    'statement a label points to, or 0 when there's no such label
    DIM i AS LONG, n$
    n$ = UCASE$(_TRIM$(nm$))
    FOR i = 1 TO labelCount
        IF labelName(i) = n$ THEN findLabel& = labelStmt(i): EXIT FUNCTION
    NEXT
END FUNCTION

SUB addData (items$)
    DIM i AS LONG, n AS LONG, it$
    REDIM parts$(0)
    n = splitArgs(items$, parts$())
    IF n = 0 THEN n = 1: REDIM parts$(1 TO 1)
    FOR i = 1 TO n
        dataCount = dataCount + 1
        IF dataCount > UBOUND(dataItem) THEN
            REDIM _PRESERVE dataItem(dataCount + 100) AS STRING
            REDIM _PRESERVE dataIsStr(dataCount + 100) AS _BYTE
        END IF
        it$ = _TRIM$(parts$(i))
        IF LEFT$(it$, 1) = CHR$(34) THEN
            dataItem(dataCount) = removeQuote$(it$)
            dataIsStr(dataCount) = true
        ELSE
            dataItem(dataCount) = it$
            dataIsStr(dataCount) = false
        END IF
    NEXT
END SUB

FUNCTION forVarName$ (f AS LONG)
    DIM u$, e AS LONG
    u$ = UCASE$(stmts(f).text)
    e = INSTR(u$, "=")
    IF e THEN forVarName$ = _TRIM$(MID$(u$, 5, e - 5))
END FUNCTION
