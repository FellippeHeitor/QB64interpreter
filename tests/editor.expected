.NEW
.LIST
  1 SUB s (n)
  2     IF n > 0 THEN 'block
  3         FOR i = 1 TO n
  4             DO WHILE x < i
  5                 x = x + 1
  6             LOOP
  7         NEXT
  8         SELECT CASE n
  9             CASE 1
 10                 PRINT "one"
 11             CASE ELSE
 12                 PRINT "many"
 13         END SELECT
 14     ELSEIF n < 0 THEN
 15         IF n = -1 THEN PRINT "single-line IF"
 16         DO: x = x - 1: LOOP UNTIL x < 0
 17     ELSE
 18         PRINT "zero"
 19     END IF
End of file - 
